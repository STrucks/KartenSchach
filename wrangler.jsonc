{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kartenschach",
  "account_id": "a226f21979b53f5b46d5bf8cdd70ae3d",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-27",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ]
}
